<?xml version='1.0' encoding='UTF-8' ?>
<!DOCTYPE mapper PUBLIC '-//mybatis.org//DTD Mapper 3.0//EN'
        'http://mybatis.org/dtd/mybatis-3-mapper.dtd'>
<mapper namespace="ru.honest.mybatis.repo.QuestionsHistoryRepo">

    <sql id="all">id, level_id, question_id, client_id, question_time</sql>

    <select id="findAll">
        SELECT <include refid="all"/>
        FROM questions_history
    </select>

    <insert id="save">
        INSERT INTO questions_history
        VALUES (#{id}, #{levelId}, #{questionId}, #{clientId}, #{time})
    </insert>

    <select id="countByClientId" resultType="int">
        SELECT COUNT(DISTINCT id)
        FROM questions_history
        WHERE client_id = #{clientId}
    </select>

    <select id="countByClientIdAndDeck" resultType="int">
        SELECT COUNT(DISTINCT qh.id)
        FROM questions_history qh
        JOIN levels l ON qh.level_id = l.id
        WHERE qh.client_id = #{clientId}
        AND l.deck_id = #{deckId}
    </select>
</mapper>